{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.production)",
      "Read(**/.env.development)",
      "Read(**/.dev.vars)",
      "Read(**/secret.key)",
      "Read(**/*.pem)",
      "Read(**/*recovery-key*)",
      "Read(**/local.properties)",
      "Read(**/keystore.properties)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Bash(sudo *)",
      "Bash(ssh *)",
      "Bash(chmod 777 *)",
      "Bash(chmod -R 777 *)",
      "Bash(dd *)",
      "Bash(* > /dev/sd*)"
    ],
    "ask": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)"
    ]
  },
  "model": "sonnet",
  "env": {
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "32000",
    "CLAUDE_CODE_SUBAGENT_MODEL": "haiku"
  }
}
